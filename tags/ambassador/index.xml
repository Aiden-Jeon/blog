&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; --repo &amp;lt;https://storage.googleapis.com/seldon-charts&amp;gt; &lt;span class="se"&gt;\\&lt;/span&gt;
